# Optional. Without a key the widget runs fully offline (extractive answers from data/faq.md).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Token the agent console must send to take over chats. CHANGE THIS.
AGENT_TOKEN=change-me
# Comma-separated origins allowed to embed the widget (* for any, fine for local demos).
ALLOWED_ORIGINS=*
